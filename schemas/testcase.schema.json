{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Li-Junming/CodeReview-SkillBench/schemas/testcase.schema.json",
  "title": "Public Code Review TestCase",
  "type": "object",
  "required": ["schema_version", "case_id", "title", "task_type", "language", "prompt_file", "source_files", "expected_output_format"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "case_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "task_type": {"const": "read_only_code_review"},
    "language": {"type": "string", "minLength": 1},
    "prompt_file": {"type": "string", "minLength": 1},
    "source_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_output_format": {"const": "structured_findings"}
  },
  "additionalProperties": false
}
